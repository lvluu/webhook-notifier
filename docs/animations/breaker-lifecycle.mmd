flowchart LR
    %% Animation intent (ADR-0014):
    %% 1. Attempt outcomes are marked in Postgres first.
    %% 2. The process-local decision engine counts consecutive failures.
    %% 3. Only lifecycle transitions are persisted asynchronously.
    %% 4. Persisted state filters claim/discovery across replicas.
    %% 5. Claim SQL designates one half-open probe Delivery.

    MARK["Delivery mark commits"]
    MEM["In-memory breaker decision engine"]
    CLOSED["closed"]
    OPEN["open"]
    PERSIST["bounded async transition persister"]
    DB[("webhooks breaker state")]
    BLOCK["claim/discovery exclude Webhook; blocked Deliveries deferred"]
    DUE["cooldown elapsed"]
    CLAIM["claim SQL atomically designates one probe Delivery"]
    HALF["half_open"]
    SUCCESS["probe or normal Attempt succeeds"]
    FAILURE["Attempt fails"]
    BACKOFF["increase cooldown up to maximum"]
    START["startup loads persisted snapshots"]

    START --> MEM
    DB --> START
    MARK -->|"record outcome after commit"| MEM
    MEM --> CLOSED
    CLOSED -->|"failure below threshold"| FAILURE
    FAILURE --> MEM
    CLOSED -->|"threshold reached"| OPEN
    OPEN --> PERSIST
    PERSIST --> DB
    DB --> BLOCK
    BLOCK -->|"breaker_next_probe_at reached"| DUE
    DUE --> CLAIM
    CLAIM -->|"persist designated probe"| DB
    CLAIM --> HALF
    HALF -->|"probe succeeds"| SUCCESS
    SUCCESS --> CLOSED
    CLOSED -->|"state transition"| PERSIST
    HALF -->|"probe fails"| BACKOFF
    BACKOFF --> OPEN

    classDef memory fill:#e8f1ff,stroke:#4d6fb3,color:#10233f;
    classDef healthy fill:#ecfdf3,stroke:#3b8f5f,color:#123524;
    classDef warning fill:#fff7e6,stroke:#c48225,color:#4a2c00;
    classDef openState fill:#fff0f0,stroke:#c45050,color:#4c1111;
    classDef db fill:#f5f0ff,stroke:#7b61b8,color:#2b2147;
    class MARK,MEM,START memory;
    class CLOSED,SUCCESS healthy;
    class FAILURE,BACKOFF,PERSIST,DUE,CLAIM,HALF warning;
    class OPEN,BLOCK openState;
    class DB db;
