flowchart LR
    %% Animation intent:
    %% 1. A producer submits an Event to one notifier replica.
    %% 2. Registry-backed ingest atomically persists the Event and Deliveries.
    %% 3. Local wakeups plus DB discovery populate each process-local Scheduler.
    %% 4. Workers claim through Postgres, POST to partners, and batch-mark outcomes.
    %% 5. Terminal rows later move out of the live queue through retention.

    PROD["Business Event producer"]

    subgraph Notifier["Webhook Notifier replicas"]
      API["HTTP ingest"]
      REG["SubscriptionRegistry; LRU + TTL"]
      DISC["DB-backed Customer discovery"]
      SCHED["Process-local Customer Scheduler"]
      WORK["Worker pool"]
      PROTECT["Signer + HostLimiter + RetryPolicy + Breaker"]
    end

    subgraph PG["Postgres: durable state and coordination"]
      WH[("webhooks")]
      EV[("events")]
      DV[("deliveries")]
      CL[("delivery_claims")]
      AT[("delivery_attempts")]
      DL[("dead_letters")]
      HIST[("delivery_history")]
    end

    PARTNER["Integration Partner URLs"]
    RETAIN["Scheduled retention command"]

    PROD -->|"POST /api/events"| API
    API -->|"resolve matching Webhooks"| REG
    REG -->|"cache miss"| WH
    API -->|"one transaction"| EV
    API -->|"one Delivery per Webhook"| DV
    API -->|"local Notify + remote wake hint"| SCHED

    DV -->|"ready Customer hint"| DISC
    WH -->|"breaker eligibility"| DISC
    DISC --> SCHED
    SCHED -->|"fair Customer picks"| WORK
    WORK -->|"atomic claim"| DV
    WORK -->|"claim lease"| CL
    WORK --> PROTECT
    PROTECT -->|"signed HTTP POST"| PARTNER
    PARTNER -->|"response or error"| PROTECT
    PROTECT -->|"batch mark success/retry/dead"| DV
    PROTECT -->|"real Attempts only"| AT
    PROTECT -->|"terminal failures"| DL

    RETAIN -->|"archive terminal Deliveries"| DV
    RETAIN --> HIST

    classDef ingress fill:#e8f1ff,stroke:#4d6fb3,color:#10233f;
    classDef runtime fill:#fff7e6,stroke:#c48225,color:#4a2c00;
    classDef db fill:#f5f0ff,stroke:#7b61b8,color:#2b2147;
    classDef partner fill:#fff0f0,stroke:#c45050,color:#4c1111;
    class PROD,API,REG ingress;
    class DISC,SCHED,WORK,PROTECT,RETAIN runtime;
    class WH,EV,DV,CL,AT,DL,HIST db;
    class PARTNER partner;
