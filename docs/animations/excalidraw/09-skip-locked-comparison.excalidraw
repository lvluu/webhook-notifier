    {
      "type": "text",
      "id": "col1_diag",
      "x": 30,
      "y": 270,
      "width": 320,
      "height": 120,
      "text": "     A          B\n     |          |\n  SELECT D-1  SELECT D-1\n     |          |\n  POST D-1   POST D-1    ← duplicate!\n     |          |\n  UPDATE ✓   UPDATE ✓    ← both succeed\n     |          |",
      "originalText": "     A          B\n     |          |\n  SELECT D-1  SELECT D-1\n     |          |\n  POST D-1   POST D-1    ← duplicate!\n     |          |\n  UPDATE ✓   UPDATE ✓    ← both succeed\n     |          |",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
