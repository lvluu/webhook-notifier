    {
      "type": "text",
      "id": "col2_diag",
      "x": 400,
      "y": 270,
      "width": 320,
      "height": 120,
      "text": "     A              B\n     |              |\n  LOCK D-1     wants D-1\n     |              |\n  POST D-1      ⏳ waiting...\n     |              |\n  COMMIT        ⏳ waiting...\n     |           unlocked → gets D-1",
      "originalText": "     A              B\n     |              |\n  LOCK D-1     wants D-1\n     |              |\n  POST D-1      ⏳ waiting...\n     |              |\n  COMMIT        ⏳ waiting...\n     |           unlocked → gets D-1",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 9042,
      "version": 2,
      "versionNonce": 1563821586,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [],
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25,
      "index": "aH",
      "frameId": null,
      "roundness": null,
      "updated": 1781399487397,
      "autoResize": true
    },
    {
      "type": "text",
      "id": "col2_verdict",
      "x": 397.7227783203125,
      "y": 405.3828125,
      "width": 320,
      "height": 120,
      "text": "Correct but slow:\n• No duplicates ✓\n• But workers serialize on same rows\n• B wastes time waiting\n• Deadlock risk with multi-row locks\n• Throughput limited by lock hold time\n\nVerdict: SAFE but CAN'T SCALE",
      "originalText": "Correct but slow:\n• No duplicates ✓\n• But workers serialize on same rows\n• B wastes time waiting\n• Deadlock risk with multi-row locks\n• Throughput limited by lock hold time\n\nVerdict: SAFE but CAN'T SCALE",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
