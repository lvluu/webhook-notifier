      "id": "col1_dup_t",
      "x": 40,
      "y": 210,
      "width": 300,
      "height": 35,
      "text": "DUPLICATE CLAIM!\nBoth workers POST D-1 to partner",
      "originalText": "DUPLICATE CLAIM!\nBoth workers POST D-1 to partner",
      "fontSize": 15,
      "fontFamily": 1,
