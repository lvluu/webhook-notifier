    },
    {
      "type": "text",
      "id": "col1_verdict",
      "x": 30,
      "y": 410,
      "width": 320,
      "height": 120,
      "text": "Problems:\n• Duplicate deliveries to partner\n• Race condition on UPDATE\n• Lost updates possible\n• No coordination at all\n• Partner gets webhook twice\n\nVerdict: BROKEN for work queues",
      "originalText": "Problems:\n• Duplicate deliveries to partner\n• Race condition on UPDATE\n• Lost updates possible\n• No coordination at all\n• Partner gets webhook twice\n\nVerdict: BROKEN for work queues",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
