    {
      "type": "text",
      "id": "retry_details",
      "x": 29.68359375,
      "y": 273.40228271484375,
      "width": 361.0887145996094,
      "height": 180,
      "text": "Retry Backoff:\n• Decorrelated jitter (not exponential)\n• Respects Retry-After header\n• Max attempts configurable\n• Optional MaxAge expiry\n\nRequeue (no attempt counted):\n• HostLimiter full → requeue with short delay\n• Coordination loss before POST → requeue",
      "originalText": "Retry Backoff:\n• Decorrelated jitter (not exponential)\n• Respects Retry-After header\n• Max attempts configurable\n• Optional MaxAge expiry\n\nRequeue (no attempt counted):\n• HostLimiter full → requeue with short delay\n• Coordination loss before POST → requeue",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
