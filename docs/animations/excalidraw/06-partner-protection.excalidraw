    {
      "type": "text",
      "id": "breaker_notes",
      "x": 45.9609375,
      "y": 278.80072021484375,
      "width": 404.25299072265625,
      "height": 93.75,
      "text": "• In-memory decisions, persisted transitions\n• Integrated into claim SQL (not post-filter)\n• Open webhooks excluded from discovery\n• Per-Webhook, NOT per-host\n• Defaults: 20 failures, 5min cooldown, 15min max",
      "originalText": "• In-memory decisions, persisted transitions\n• Integrated into claim SQL (not post-filter)\n• Open webhooks excluded from discovery\n• Per-Webhook, NOT per-host\n• Defaults: 20 failures, 5min cooldown, 15min max",
      "fontSize": 15,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
