    {
      "type": "text",
      "id": "comparison",
      "x": 50,
      "y": 475,
      "width": 420,
      "height": 150,
      "text": "FOR UPDATE (without SKIP LOCKED):\n  Worker B BLOCKS until A commits\n  → serialized, slow, deadlock risk\n\nFOR UPDATE SKIP LOCKED:\n  Worker B instantly skips locked rows\n  → takes next available rows\n  → no blocking, no duplicates\n  → workers run fully parallel",
      "originalText": "FOR UPDATE (without SKIP LOCKED):\n  Worker B BLOCKS until A commits\n  → serialized, slow, deadlock risk\n\nFOR UPDATE SKIP LOCKED:\n  Worker B instantly skips locked rows\n  → takes next available rows\n  → no blocking, no duplicates\n  → workers run fully parallel",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 8240,
      "version": 2,
      "versionNonce": 290180534,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [],
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25,
      "index": "ah",
      "frameId": null,
      "roundness": null,
      "updated": 1781355022916,
      "autoResize": true
    },
    {
      "type": "text",
      "id": "sql_title",
      "x": 520,
      "y": 435,
      "width": 250,
      "height": 25,
      "text": "🔵 Actual SQL pattern:",
      "originalText": "🔵 Actual SQL pattern:",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
