    {
      "type": "text",
      "id": "sql_code",
      "x": 520,
      "y": 465,
      "width": 341.15260260445723,
      "height": 231.5702514648437,
      "text": "WITH candidates AS (\n  SELECT id FROM deliveries\n  WHERE status IN ('pending','failed_retry')\n    AND next_attempt_at <= now()\n  ORDER BY next_attempt_at\n  LIMIT $batch_size\n  FOR UPDATE SKIP LOCKED\n)\nINSERT INTO delivery_claims\n  (delivery_id, claimed_at)\nSELECT id, now() FROM candidates\nON CONFLICT (delivery_id)\n  DO UPDATE SET claimed_at = now()\n  WHERE claimed_at < now() - $lease",
      "originalText": "WITH candidates AS (\n  SELECT id FROM deliveries\n  WHERE status IN ('pending','failed_retry')\n    AND next_attempt_at <= now()\n  ORDER BY next_attempt_at\n  LIMIT $batch_size\n  FOR UPDATE SKIP LOCKED\n)\nINSERT INTO delivery_claims\n  (delivery_id, claimed_at)\nSELECT id, now() FROM candidates\nON CONFLICT (delivery_id)\n  DO UPDATE SET claimed_at = now()\n  WHERE claimed_at < now() - $lease",
      "fontSize": 13.232585797991069,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 8260,
      "version": 12,
      "versionNonce": 1123220050,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [],
      "link": null,
